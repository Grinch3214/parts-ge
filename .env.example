# Copy to .env.local (ignored by git) for local testing; on Netlify set them in the dashboard.

# Server-only secrets — never prefix with VITE_
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string; protects /api/telegram-webhook (card buttons). npm run tg:webhook suggests one.
TELEGRAM_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=

# Public (shipped to the browser)
VITE_TURNSTILE_SITE_KEY=
