<section class="hero" aria-labelledby="hero-title">
	<div class="container hero__grid">
		<div class="hero__intro">
			<p class="eyebrow hero__eyebrow">{{t.hero.eyebrow}}</p>
			<h1 class="hero__title" id="hero-title">{{t.hero.title}}</h1>
			<p class="hero__lead">{{t.hero.lead}}</p>

			<ul class="hero__trust">
				{{#each t.hero.trust}}
				<li>{{> components/icon name=icon}}<span>{{text}}</span></li>
				{{/each}}
			</ul>

			{{> components/vin-plate}}
		</div>

		<div class="hero__form" id="request">
			{{> components/request-form}}
		</div>
	</div>
</section>
