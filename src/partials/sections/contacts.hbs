<section class="section contacts" id="contacts" aria-labelledby="contacts-title">
	<div class="container">
		<div class="contacts__card" data-reveal>
			<div class="contacts__intro">
				<p class="eyebrow">{{t.contacts.eyebrow}}</p>
				<h2 class="section__title" id="contacts-title">{{t.contacts.title}}</h2>
				<p class="contacts__text">{{t.contacts.text}}</p>
				<a class="btn btn--primary btn--lg contacts__cta" href="#request" data-to-form>
					{{t.contacts.cta}}
					{{> components/icon name="arrow-right" cls="btn__arrow"}}
				</a>
				<p class="contacts__city">{{> components/icon name="pin"}}{{t.contacts.city}}</p>
			</div>

			<ul class="contacts__list">
				<li>
					<a class="messenger" href="{{links.whatsapp}}" target="_blank" rel="noopener">
						<span class="messenger__icon">{{> components/icon name="whatsapp"}}</span>
						<span class="messenger__body">
							<span class="messenger__name">WhatsApp</span>
							<span class="messenger__handle">{{site.phoneDisplay}}</span>
						</span>
						{{> components/icon name="arrow-up-right" cls="messenger__arrow"}}
					</a>
				</li>
				<li>
					<a class="messenger" href="{{links.telegram}}" target="_blank" rel="noopener">
						<span class="messenger__icon">{{> components/icon name="telegram"}}</span>
						<span class="messenger__body">
							<span class="messenger__name">Telegram</span>
							<span class="messenger__handle">@{{site.telegram}}</span>
						</span>
						{{> components/icon name="arrow-up-right" cls="messenger__arrow"}}
					</a>
				</li>
				<li>
					<a class="messenger" href="{{links.viber}}">
						<span class="messenger__icon">{{> components/icon name="viber"}}</span>
						<span class="messenger__body">
							<span class="messenger__name">Viber</span>
							<span class="messenger__handle">{{site.phoneDisplay}}</span>
						</span>
						{{> components/icon name="arrow-up-right" cls="messenger__arrow"}}
					</a>
				</li>
				<li>
					<a class="messenger" href="{{links.tel}}">
						<span class="messenger__icon">{{> components/icon name="phone"}}</span>
						<span class="messenger__body">
							<span class="messenger__name">{{t.contacts.phoneLabel}}</span>
							<span class="messenger__handle">{{site.phoneDisplay}}</span>
						</span>
						{{> components/icon name="arrow-up-right" cls="messenger__arrow"}}
					</a>
				</li>
			</ul>
		</div>
	</div>
</section>
