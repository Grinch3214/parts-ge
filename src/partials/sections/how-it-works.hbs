<section class="section how" id="how" aria-labelledby="how-title">
	<div class="container">
		{{> components/rule code="PROCESS"}}

		<div class="how__top">
			<header class="section__head" data-reveal>
				<p class="eyebrow">{{t.how.eyebrow}}</p>
				<h2 class="section__title" id="how-title">{{t.how.title}}</h2>
			</header>

			{{> components/vin-plate}}
		</div>

		<ol class="steps">
			{{#each t.how.steps}}
			<li class="steps__item" data-reveal style="--d: {{@index}}">
				<div class="steps__top">
					<span class="steps__num">{{num}}</span>
					<span class="steps__icon">{{> components/icon name=icon}}</span>
				</div>
				<h3 class="steps__title">{{title}}</h3>
				<p class="steps__text">{{text}}</p>
			</li>
			{{/each}}
		</ol>
	</div>
</section>
