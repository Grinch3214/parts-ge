<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{t.meta.title}}</title>
<meta name="description" content="{{t.meta.description}}">
<link rel="canonical" href="{{canonical}}">
{{#each locales}}
<link rel="alternate" hreflang="{{code}}" href="{{absUrl}}">
{{/each}}
<link rel="alternate" hreflang="x-default" href="{{defaultUrl}}">
{{#unless indexable}}
<meta name="robots" content="noindex, nofollow">
{{/unless}}
<meta name="theme-color" content="#121417">
<meta name="format-detection" content="telephone=no">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/src/scss/style.scss">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{site.name}}">
<meta property="og:title" content="{{t.meta.title}}">
<meta property="og:description" content="{{t.meta.description}}">
<meta property="og:url" content="{{canonical}}">
<meta property="og:image" content="{{site.url}}/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ogLocale}}">
{{#each ogAlternates}}
<meta property="og:locale:alternate" content="{{this}}">
{{/each}}
<meta name="twitter:card" content="summary_large_image">

{{!-- js flag + "returning visitor" flag: the hero intro animation plays only on the first page of a visit --}}
<script>
	(function (root) {
		root.classList.replace('no-js', 'js')
		try {
			if (sessionStorage.getItem('bp:seen')) root.classList.add('no-intro')
			sessionStorage.setItem('bp:seen', '1')
		} catch (e) {}
	})(document.documentElement)
</script>
{{!-- Prefetch the other language page on hover/touch, so switching is near-instant (Chromium; ignored elsewhere) --}}
<script type="speculationrules">
	{ "prefetch": [{ "source": "document", "where": { "selector_matches": "[data-lang-link]" }, "eagerness": "moderate" }] }
</script>
<script type="application/ld+json">{{{json schema.business}}}</script>
<script type="application/ld+json">{{{json schema.faq}}}</script>
